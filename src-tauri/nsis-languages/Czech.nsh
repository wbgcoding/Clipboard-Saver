; Tauri custom installer strings - Czech (tauri ships no built-in translation).
LangString addOrReinstall ${LANG_CZECH} "Přidat/Přeinstalovat součásti"
LangString alreadyInstalled ${LANG_CZECH} "Již nainstalováno"
LangString alreadyInstalledLong ${LANG_CZECH} "${PRODUCTNAME} ${VERSION} je již nainstalován. Vyberte operaci, kterou chcete provést, a pokračujte kliknutím na Další."
LangString appRunning ${LANG_CZECH} "${PRODUCTNAME} je spuštěn! Nejprve jej zavřete a zkuste to znovu."
LangString appRunningOkKill ${LANG_CZECH} "${PRODUCTNAME} je spuštěn!$\nKliknutím na OK jej ukončíte"
LangString chooseMaintenanceOption ${LANG_CZECH} "Vyberte operaci údržby, kterou chcete provést."
LangString choowHowToInstall ${LANG_CZECH} "Vyberte způsob instalace ${PRODUCTNAME}."
LangString createDesktop ${LANG_CZECH} "Vytvořit zástupce na ploše"
LangString dontUninstall ${LANG_CZECH} "Neodinstalovávat"
LangString dontUninstallDowngrade ${LANG_CZECH} "Neodinstalovávat (instalace starší verze bez odinstalace je v tomto instalátoru zakázána)"
LangString failedToKillApp ${LANG_CZECH} "Nepodařilo se ukončit ${PRODUCTNAME}. Nejprve jej zavřete a zkuste to znovu"
LangString installingWebview2 ${LANG_CZECH} "Instalace WebView2..."
LangString newerVersionInstalled ${LANG_CZECH} "Novější verze ${PRODUCTNAME} je již nainstalována! Instalace starší verze se nedoporučuje. Pokud opravdu chcete nainstalovat tuto starší verzi, je lepší nejprve odinstalovat aktuální verzi. Vyberte operaci, kterou chcete provést, a pokračujte kliknutím na Další."
LangString older ${LANG_CZECH} "starší"
LangString olderOrUnknownVersionInstalled ${LANG_CZECH} "Ve vašem systému je nainstalována $R4 verze ${PRODUCTNAME}. Před instalací doporučujeme odinstalovat aktuální verzi. Vyberte operaci, kterou chcete provést, a pokračujte kliknutím na Další."
LangString silentDowngrades ${LANG_CZECH} "Instalace starší verze je v tomto instalátoru zakázána, nelze pokračovat v tichém režimu, použijte prosím instalátor s grafickým rozhraním.$\n"
LangString unableToUninstall ${LANG_CZECH} "Nelze odinstalovat!"
LangString uninstallApp ${LANG_CZECH} "Odinstalovat ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_CZECH} "Odinstalovat před instalací"
LangString unknown ${LANG_CZECH} "neznámá"
LangString webview2AbortError ${LANG_CZECH} "Instalace WebView2 se nezdařila! Aplikace bez něj nemůže běžet. Zkuste restartovat instalátor."
LangString webview2DownloadError ${LANG_CZECH} "Chyba: stahování WebView2 se nezdařilo - $0"
LangString webview2DownloadSuccess ${LANG_CZECH} "Bootstrapper WebView2 byl úspěšně stažen"
LangString webview2Downloading ${LANG_CZECH} "Stahování bootstrapperu WebView2..."
LangString webview2InstallError ${LANG_CZECH} "Chyba: instalace WebView2 selhala s kódem ukončení $1"
LangString webview2InstallSuccess ${LANG_CZECH} "WebView2 byl úspěšně nainstalován"
LangString deleteAppData ${LANG_CZECH} "Smazat data aplikace"
