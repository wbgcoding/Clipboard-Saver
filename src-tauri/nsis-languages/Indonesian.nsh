; Tauri custom installer strings - Indonesian (tauri ships no built-in translation).
LangString addOrReinstall ${LANG_INDONESIAN} "Tambah/Instal ulang komponen"
LangString alreadyInstalled ${LANG_INDONESIAN} "Sudah Terpasang"
LangString alreadyInstalledLong ${LANG_INDONESIAN} "${PRODUCTNAME} ${VERSION} sudah terpasang. Pilih operasi yang ingin Anda lakukan dan klik Berikutnya untuk melanjutkan."
LangString appRunning ${LANG_INDONESIAN} "${PRODUCTNAME} sedang berjalan! Tutup terlebih dahulu lalu coba lagi."
LangString appRunningOkKill ${LANG_INDONESIAN} "${PRODUCTNAME} sedang berjalan!$\nKlik OK untuk menutupnya"
LangString chooseMaintenanceOption ${LANG_INDONESIAN} "Pilih opsi pemeliharaan yang akan dilakukan."
LangString choowHowToInstall ${LANG_INDONESIAN} "Pilih cara Anda ingin memasang ${PRODUCTNAME}."
LangString createDesktop ${LANG_INDONESIAN} "Buat pintasan desktop"
LangString dontUninstall ${LANG_INDONESIAN} "Jangan hapus pemasangan"
LangString dontUninstallDowngrade ${LANG_INDONESIAN} "Jangan hapus pemasangan (menurunkan versi tanpa menghapus pemasangan dinonaktifkan untuk pemasang ini)"
LangString failedToKillApp ${LANG_INDONESIAN} "Gagal menutup ${PRODUCTNAME}. Tutup terlebih dahulu lalu coba lagi"
LangString installingWebview2 ${LANG_INDONESIAN} "Memasang WebView2..."
LangString newerVersionInstalled ${LANG_INDONESIAN} "Versi ${PRODUCTNAME} yang lebih baru sudah terpasang! Tidak disarankan memasang versi yang lebih lama. Jika Anda benar-benar ingin memasang versi lama ini, sebaiknya hapus pemasangan versi saat ini terlebih dahulu. Pilih operasi yang ingin Anda lakukan dan klik Berikutnya untuk melanjutkan."
LangString older ${LANG_INDONESIAN} "lebih lama"
LangString olderOrUnknownVersionInstalled ${LANG_INDONESIAN} "Versi $R4 dari ${PRODUCTNAME} terpasang di sistem Anda. Disarankan untuk menghapus pemasangan versi saat ini sebelum memasang. Pilih operasi yang ingin Anda lakukan dan klik Berikutnya untuk melanjutkan."
LangString silentDowngrades ${LANG_INDONESIAN} "Penurunan versi dinonaktifkan untuk pemasang ini, tidak dapat melanjutkan dengan pemasang senyap, silakan gunakan pemasang antarmuka grafis sebagai gantinya.$\n"
LangString unableToUninstall ${LANG_INDONESIAN} "Tidak dapat menghapus pemasangan!"
LangString uninstallApp ${LANG_INDONESIAN} "Hapus pemasangan ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_INDONESIAN} "Hapus pemasangan sebelum memasang"
LangString unknown ${LANG_INDONESIAN} "tidak diketahui"
LangString webview2AbortError ${LANG_INDONESIAN} "Gagal memasang WebView2! Aplikasi tidak dapat berjalan tanpanya. Coba mulai ulang pemasang."
LangString webview2DownloadError ${LANG_INDONESIAN} "Kesalahan: pengunduhan WebView2 gagal - $0"
LangString webview2DownloadSuccess ${LANG_INDONESIAN} "Bootstrapper WebView2 berhasil diunduh"
LangString webview2Downloading ${LANG_INDONESIAN} "Mengunduh bootstrapper WebView2..."
LangString webview2InstallError ${LANG_INDONESIAN} "Kesalahan: pemasangan WebView2 gagal dengan kode keluar $1"
LangString webview2InstallSuccess ${LANG_INDONESIAN} "WebView2 berhasil dipasang"
LangString deleteAppData ${LANG_INDONESIAN} "Hapus data aplikasi"
