; Tauri custom installer strings - Hindi (tauri ships no built-in translation).
LangString addOrReinstall ${LANG_HINDI} "घटक जोड़ें/पुनः इंस्टॉल करें"
LangString alreadyInstalled ${LANG_HINDI} "पहले से इंस्टॉल है"
LangString alreadyInstalledLong ${LANG_HINDI} "${PRODUCTNAME} ${VERSION} पहले से इंस्टॉल है। आप जो कार्य करना चाहते हैं उसे चुनें और जारी रखने के लिए अगला पर क्लिक करें।"
LangString appRunning ${LANG_HINDI} "${PRODUCTNAME} चल रहा है! कृपया पहले इसे बंद करें और फिर पुनः प्रयास करें।"
LangString appRunningOkKill ${LANG_HINDI} "${PRODUCTNAME} चल रहा है!$\nइसे बंद करने के लिए OK पर क्लिक करें"
LangString chooseMaintenanceOption ${LANG_HINDI} "करने के लिए रखरखाव विकल्प चुनें।"
LangString choowHowToInstall ${LANG_HINDI} "चुनें कि आप ${PRODUCTNAME} को कैसे इंस्टॉल करना चाहते हैं।"
LangString createDesktop ${LANG_HINDI} "डेस्कटॉप शॉर्टकट बनाएं"
LangString dontUninstall ${LANG_HINDI} "अनइंस्टॉल न करें"
LangString dontUninstallDowngrade ${LANG_HINDI} "अनइंस्टॉल न करें (इस इंस्टॉलर के लिए बिना अनइंस्टॉल किए डाउनग्रेड करना अक्षम है)"
LangString failedToKillApp ${LANG_HINDI} "${PRODUCTNAME} को बंद करने में विफल। कृपया पहले इसे बंद करें और फिर पुनः प्रयास करें"
LangString installingWebview2 ${LANG_HINDI} "WebView2 इंस्टॉल हो रहा है..."
LangString newerVersionInstalled ${LANG_HINDI} "${PRODUCTNAME} का एक नया संस्करण पहले से इंस्टॉल है! पुराना संस्करण इंस्टॉल करने की अनुशंसा नहीं की जाती। यदि आप वास्तव में यह पुराना संस्करण इंस्टॉल करना चाहते हैं, तो पहले वर्तमान संस्करण को अनइंस्टॉल करना बेहतर है। आप जो कार्य करना चाहते हैं उसे चुनें और जारी रखने के लिए अगला पर क्लिक करें।"
LangString older ${LANG_HINDI} "पुराना"
LangString olderOrUnknownVersionInstalled ${LANG_HINDI} "आपके सिस्टम पर ${PRODUCTNAME} का एक $R4 संस्करण इंस्टॉल है। इंस्टॉल करने से पहले वर्तमान संस्करण को अनइंस्टॉल करने की अनुशंसा की जाती है। आप जो कार्य करना चाहते हैं उसे चुनें और जारी रखने के लिए अगला पर क्लिक करें।"
LangString silentDowngrades ${LANG_HINDI} "इस इंस्टॉलर के लिए डाउनग्रेड अक्षम हैं, साइलेंट इंस्टॉलर के साथ आगे नहीं बढ़ा जा सकता, कृपया इसके बजाय ग्राफ़िकल इंटरफ़ेस इंस्टॉलर का उपयोग करें।$\n"
LangString unableToUninstall ${LANG_HINDI} "अनइंस्टॉल करने में असमर्थ!"
LangString uninstallApp ${LANG_HINDI} "${PRODUCTNAME} अनइंस्टॉल करें"
LangString uninstallBeforeInstalling ${LANG_HINDI} "इंस्टॉल करने से पहले अनइंस्टॉल करें"
LangString unknown ${LANG_HINDI} "अज्ञात"
LangString webview2AbortError ${LANG_HINDI} "WebView2 इंस्टॉल करने में विफल! इसके बिना ऐप नहीं चल सकता। इंस्टॉलर को पुनः आरंभ करने का प्रयास करें।"
LangString webview2DownloadError ${LANG_HINDI} "त्रुटि: WebView2 डाउनलोड करने में विफल - $0"
LangString webview2DownloadSuccess ${LANG_HINDI} "WebView2 बूटस्ट्रैपर सफलतापूर्वक डाउनलोड हुआ"
LangString webview2Downloading ${LANG_HINDI} "WebView2 बूटस्ट्रैपर डाउनलोड हो रहा है..."
LangString webview2InstallError ${LANG_HINDI} "त्रुटि: WebView2 इंस्टॉलेशन एग्ज़िट कोड $1 के साथ विफल"
LangString webview2InstallSuccess ${LANG_HINDI} "WebView2 सफलतापूर्वक इंस्टॉल हुआ"
LangString deleteAppData ${LANG_HINDI} "एप्लिकेशन डेटा हटाएं"
